# =============================================================================
# APPI environment template
# Copy to the repo root as `.env` (same folder as this file):
#   copy .env.example .env
# Or run:  powershell -ExecutionPolicy Bypass -File .\scripts\setup.ps1
#
# Location:  APPI-0.1.0\APPI-0.1.0\.env
# Loaded by: services/api (brain) and apps/device-agent (runtime)
# Web only needs NEXT_PUBLIC_* below (Next.js reads them from this same file
# if you symlink/copy, or set them when running npm).
# Never commit a real `.env`.
# =============================================================================

# --- Database ---
# Local default: SQLite file next to the API process.
DATABASE_URL=sqlite+aiosqlite:///./appi.db
# Production Postgres example:
# DATABASE_URL=postgresql+asyncpg://appi:appi@localhost:5432/appi

# Optional hosted Postgres / auth / realtime (leave empty for local SQLite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI planner ---
# openai | anthropic | openai_compatible | heuristic
# Without a key, Appi uses the heuristic planner (Guardian still authorizes).
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# OPENAI_API_KEY is also accepted as a fallback for AI_API_KEY.
OPENAI_API_KEY=

# --- Auth / crypto ---
# Replace these before any shared or production use.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Any long random passphrase (not a Fernet token).
ENCRYPTION_KEY=change-me-to-another-long-random-passphrase

# --- API (cloud brain) ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public website + operator URL (used for OAuth return redirects)
APP_URL=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Device agent / Universal Runtime ---
DEVICE_AGENT_API_URL=http://127.0.0.1:8000
DEVICE_NAME=
RUNTIME_VERSION=0.3.0

# --- GitHub OAuth (optional; leave empty to paste a verified PAT instead) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=http://127.0.0.1:8000/api/v1/connections/github/oauth/callback

# --- Google OAuth (Gmail + Calendar share the client; different redirects) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8000/api/v1/connections/gmail/oauth/callback
GOOGLE_CALENDAR_OAUTH_REDIRECT=http://127.0.0.1:8000/api/v1/connections/google_calendar/oauth/callback

# --- Rate limits ---
RATE_LIMIT_PER_MINUTE=120

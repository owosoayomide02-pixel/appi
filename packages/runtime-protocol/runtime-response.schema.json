  "$id": "https://appi.dev/schemas/runtime-response.json",
  "title": "AppiRuntimeResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["success"],
  "properties": {
    "success": { "type": "boolean" },
    "platform": { "type": "string" },
    "result": {},
